# ── Laravel ───────────────────────────────────
APP_ENV=production
APP_KEY=base64:REPLACE_ME
APP_DEBUG=false

# ── PostgreSQL ────────────────────────────────
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
